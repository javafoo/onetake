# Copy to .env.local and fill in. Names only here: never commit values.

# --- Models ---
# Gemini: text, images and Omni talking clips. aistudio.google.com, billing on.
GEMINI_API_KEY=
# Optional model overrides.
GEMINI_TEXT_MODEL=
GEMINI_AGENT_MODEL=
GEMINI_IMAGE_MODEL_PRO=
GEMINI_IMAGE_MODEL_DAILY=

# Optional: your own photo style as one line of JSON (see src/style/load-style.ts).
# Without it the plain style in the repository is used.
HOUSE_STYLE=

# --- Accounts (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Signing secret for /api/clerk/webhook (user.deleted erases the account's data).
# Without it the route answers 503.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Database (Neon Postgres) ---
DATABASE_URL=
# Migrations run against the direct (unpooled) connection.
DATABASE_URL_UNPOOLED=

# --- Media storage ---
# Locally, files go to the filesystem (STORAGE_FS_ROOT, default a folder in the system temp dir).
# Hosted, connect a private Vercel Blob store to the project; Vercel sets the token.
STORAGE_DRIVER=
STORAGE_FS_ROOT=
BLOB_READ_WRITE_TOKEN=

# --- Scheduled work ---
# Shared secret for /api/cron/jobs, sent by Vercel Cron as a Bearer token. 16+ characters.
CRON_SECRET=

# --- Safety ---
# Hard stop on what the app spends on providers per UTC day, in dollars, across all users.
GLOBAL_DAILY_BUDGET_USD=25
# Token for /api/health/render (404 without it).
HEALTH_TOKEN=

# --- Rendering and headers (leave unset normally) ---
FFMPEG_BINARY=
CSP_REPORT_ONLY=
